# Copie para .env — nunca commite segredos reais.
DATABASE_URL=postgresql+psycopg://financemed:financemed@localhost:5432/financemed
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
NEXT_PUBLIC_API_URL=http://localhost:8000

# Segredo do webhook do provedor de pagamento (vazio = webhook desligado)
BILLING_WEBHOOK_SECRET=

# Segurança (obrigatório fora de dev: ENVIRONMENT=prod exige SECRET_KEY próprio e COOKIE_SECURE=true)
ENVIRONMENT=dev
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=60
