# Copie para .env.prod no servidor e preencha. NUNCA commite o .env.prod.
DOMAIN=app.seudominio.com
# RDS PostgreSQL 16. Senha só com letras e números (evita escapar a URL).
DATABASE_URL=postgresql+psycopg://financemed:SENHA_DO_RDS@ENDPOINT_DO_RDS:5432/financemed?sslmode=require
ENVIRONMENT=prod
# openssl rand -hex 32  (guarde num cofre: cifra o 2FA; se perder, quem usa 2FA não consegue entrar)
SECRET_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=https://app.seudominio.com
TRUST_PROXY_HEADERS=true
# Vazio = webhook de pagamento desligado (cobrança simulada).
BILLING_WEBHOOK_SECRET=
